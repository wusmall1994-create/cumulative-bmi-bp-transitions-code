# Copy this file to .env or define these variables in your shell.
# Never commit local paths, credentials, or restricted cohort data.
HRS_DATA_DIR=/path/to/hrs
CHNS_DATA_DIR=/path/to/chns
ELSA_DATA_DIR=/path/to/elsa
# Optional; defaults to <repository>/outputs
BMI_BP_OUTPUT_DIR=/path/to/private/output

